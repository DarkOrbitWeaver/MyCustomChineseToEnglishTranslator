{
  "manifest_version": 3,
  "name": "LiveSubs",
  "version": "1.0.0",
  "description": "Live AI-powered English subtitles for Chinese YouTube videos",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "LiveSubs", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } }
}
