{
  "manifest_version": 3,
  "name": "LiveSubs",
  "version": "0.1.0",
  "description": "Live English subs for Chinese YouTube videos via a local backend",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "LiveSubs" }
}
